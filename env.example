# Server
PORT=3000

# JWT (required — app crashes without it)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Superadmin seed (set SEED_SUPERADMIN=true to seed on first run)
SEED_SUPERADMIN=false
SUPERADMIN_EMAIL=admin@zudo.app
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_PIN=0000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database
DB_PROVIDER=sqlite
DB_NAME=dev

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zudo POS <noreply@zudo.app>

# Payment API
PAYMENT_API_URL=
PAYMENT_API_KEY=

# Firebase Cloud Messaging
FCM_API_URL=https://fcm.googleapis.com/fcm/send
FIREBASE_SERVER_KEY=

# Crypto
COINGECKO_API_URL=https://api.coingecko.com/api/v3
BTC_EXPLORER_URL=https://blockchain.info
ETH_EXPLORER_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=
